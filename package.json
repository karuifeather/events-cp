{
  "name": "events",
  "version": "1.0.0",
  "private": true,
  "description": "Anime Atlas is an anime-themed community space with a React frontend and PostgreSQL-backed events.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node --watch server.js",
    "client": "npm --prefix client run dev -- --host 0.0.0.0",
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "build": "npm --prefix client run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "workspaces": [
    "client"
  ],
  "keywords": [
    "anime",
    "events",
    "express",
    "postgresql",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.9.9"
  }
}
